# ─────────────────────────────────────────────────────────────
# Copia este archivo como .env.local (en tu PC) o pega estas
# variables en Vercel → Settings → Environment Variables.
# Si dejas vacías las de Supabase, la tienda funciona en
# "modo demostración" con los 6 productos de ejemplo.
# ─────────────────────────────────────────────────────────────

# Dirección pública de tu tienda (sin / al final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ¡SECRETA! Nunca la compartas ni la pongas con NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Wompi → Desarrolladores → Llaves del API
# En pruebas usa las llaves pub_test_ / prv_test_ ; en producción pub_prod_ / prv_prod_
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# Wompi → Desarrolladores → Secretos para integración técnica
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Resend (correos) → https://resend.com/api-keys
RESEND_API_KEY=
# Debe ser un correo de un dominio verificado en Resend
EMAIL_FROM="Lore Importaciones <pedidos@loreimportaciones.com>"
# Correo donde TÚ recibes aviso de pedidos y mensajes nuevos
ADMIN_NOTIFY_EMAIL=
